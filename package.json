{
  "name": "@realuptime/errors",
  "version": "0.6.0",
  "description": "Zero-dependency error tracking SDK for JavaScript and Node (RealUptime Errors).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sourcemaps": {
      "types": "./dist/sourcemaps.d.ts",
      "import": "./dist/sourcemaps.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.ts",
    "client.ts",
    "buffer.ts",
    "scrub.ts",
    "custom-scrub.ts",
    "types.ts",
    "feedback.ts",
    "sourcemaps.ts",
    "vite.ts",
    "webpack.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://realuptime.io/error-tracking",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealUptimeHQ/realuptime-errors-js.git"
  },
  "bugs": {
    "url": "https://github.com/RealUptimeHQ/realuptime-errors-js/issues"
  },
  "dependencies": {},
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jsdom": "30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
